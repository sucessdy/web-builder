# Copy this file to .env.local and fill in the values from your Appwrite project.
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# Optional server-side generator bridge. Do not put model provider secrets here.
VITE_AI_GENERATION_ENDPOINT=http://localhost:3000/api/generate
