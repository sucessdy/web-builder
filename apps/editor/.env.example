# Copy this file to .env.local and fill in the values from your Appwrite project.
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=

# NestJS API. Keep model provider secrets in apps/api/.env, never here.
VITE_API_URL=http://localhost:3000/api
VITE_AI_GENERATION_ENDPOINT=http://localhost:3000/api/ai/generate
